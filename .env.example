# Configure estas variáveis no painel do Netlify (Site configuration → Environment variables).
# Para desenvolvimento local com `netlify dev`, copie para .env e preencha.

# Obrigatórias
ANTHROPIC_API_KEY=
FISH_AUDIO_API_KEY=
# Usada só nos turnos de repetição guiada (pronúncia); o resto da fala continua na
# Web Speech API do navegador, sem custo. Conta em assemblyai.com.
ASSEMBLYAI_API_KEY=

# Recomendada: código que o app pede uma vez por aparelho. Sem ela, qualquer
# pessoa com a URL do site consegue usar (e gastar) suas chaves de API.
APP_ACCESS_CODE=

# Opcionais
# ID da voz no Fish Audio (fish.audio → escolha uma voz francesa → copie o ID do modelo).
FISH_AUDIO_VOICE_ID=
# Modelo de TTS do Fish Audio (header "model"). Vazio = s2.1-pro-free (gratuito, sem
# limite rígido de créditos). Só preencha para trocar por um modelo pago (ex: s2.1-pro).
FISH_AUDIO_MODEL=
# Modelo do Claude na conversa por voz. Padrão: claude-sonnet-5
CLAUDE_MODEL=
# Modelo do Claude no encerramento (resumo + Caderno). Padrão: claude-haiku-4-5
SUMMARY_MODEL=
